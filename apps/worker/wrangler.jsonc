{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "book-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "ENVIRONMENT": "local",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "book-hub-local",
      "database_id": "local-book-hub",
      "migrations_dir": "../../packages/database/migrations",
    },
  ],
}
