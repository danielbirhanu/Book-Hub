{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "book-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "ENVIRONMENT": "local",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "book-hub-local",
      "database_id": "local-book-hub",
      "migrations_dir": "../../packages/database/migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  "env": {
    "preview": {
      "name": "book-hub-preview",
      "vars": { "ENVIRONMENT": "preview" },
    },
    "production": {
      "name": "book-hub",
      "vars": { "ENVIRONMENT": "production" },
      "durable_objects": {
        "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "book-hub-production",
          "database_id": "6685bf6b-b26c-490d-b88c-d71b2e0a84f2",
          "migrations_dir": "../../packages/database/migrations",
        },
      ],
    },
  },
}
